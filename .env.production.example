# Copy to .env.production on the server and fill in. Never commit the real file.
APP_PORT=3100
NEXT_PUBLIC_APP_NAME=Pivora
NEXT_PUBLIC_APP_URL=https://lms.example.com
APP_URL=https://lms.example.com
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

POSTGRES_USER=engclass
POSTGRES_DB=engclass
POSTGRES_PASSWORD=            # openssl rand -hex 24

AUTH_SECRET=                  # openssl rand -base64 48
AUTH_TRUST_HOST=true

STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=20
PROCTOR_SNAPSHOT_RETENTION_DAYS=30

# Google Drive (optional, see docs/GOOGLE_DRIVE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_ENCRYPTION_KEY=         # openssl rand -base64 48
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Phase 13 — Admin 2FA (TOTP) & Error Tracking (optional)
TOTP_ENCRYPTION_KEY=          # openssl rand -base64 48 (falls back to AUTH_SECRET if empty)
SENTRY_DSN=                   # optional Sentry DSN for external error forwarding

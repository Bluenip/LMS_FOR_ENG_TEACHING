generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
}

enum LessonItemType {
  PDF
  VIDEO
  AUDIO
  LINK
}

enum FieldPlacement {
  OVERLAY
  ANSWER_SHEET
}

enum FieldType {
  TEXT
  NUMBER
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  TRUE_FALSE_GROUP
  DROPDOWN
  CHECKBOX
  ESSAY
  DICTATION
  PHOTO_UPLOAD
  MATCH
  DRAG_DROP
  SPEAKING
  VOICE_ANSWER
  HIGHLIGHT
  ORDERING
  WORDSEARCH
  DRAW
  CODE
}

enum WorksheetSubject {
  ENGLISH
  MATH
  PHYSICS
  CHEMISTRY
  BIOLOGY
  LITERATURE
  HISTORY
  GEOGRAPHY
  CIVICS
  INFORMATICS
  GENERAL
}

enum SkillTag {
  GRAMMAR
  VOCABULARY
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum ShowResultMode {
  NEVER
  AFTER_SUBMIT
  AFTER_DUE
}

enum LeaderboardMode {
  OFF
  AFTER_SUBMIT
  AFTER_DUE
}

enum ProctorMode {
  OFF
  MONITOR
  LOCKDOWN
  SEB
}

enum ViolationAction {
  WARN
  LOCK
  RESTART
  AUTO_SUBMIT
}

enum CameraSensitivity {
  LOW
  MEDIUM
  HIGH
}

enum ProctorEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY
  PASTE
  CUT
  CONTEXT_MENU
  PRINT_SCREEN_KEY
  DEVTOOLS_SUSPECTED
  MULTI_SCREEN
  MULTI_SESSION
  NETWORK_OFFLINE
  RESIZE_SUSPICIOUS
  DROP
  PASTE_SUSPECTED
  CAMERA_NO_FACE
  CAMERA_MULTI_FACE
  CAMERA_LOOK_AWAY
  CAMERA_PHONE
  CAMERA_OFF
  CAMERA_GAZE_AWAY
  MIC_VOICE
  MOBILE_APP_SWITCH
}

enum ClassRole {
  OWNER
  CO_TEACHER
  ASSISTANT
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  RETURNED
}

enum NotificationType {
  ASSIGNMENT_CREATED
  SUBMISSION_GRADED
  SUBMISSION_RETURNED
  ENROLLMENT_REQUEST
  ENROLLMENT_APPROVED
  POST_CREATED
  PROCTOR_REMINDER
  PARENT_ALERT
  SYSTEM_ALERT
  DUE_REMINDER
  ATTENDANCE_ALERT
  PARENT_MESSAGE
  WEEKLY_REPORT
}

enum AttendanceStatus {
  PRESENT
  EXCUSED
  ABSENT
  LATE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ScoreScale {
  SCALE_10
  SCALE_100
  IELTS
  RAW
}

enum DriveConnectionStatus {
  ACTIVE
  REVOKED
  DISCONNECTED
}

enum DriveFileKind {
  WORKSHEET_PDF
  WORKSHEET_AUDIO
  WORD_SOURCE
  BACKUP
  LESSON_FILE
  SUBMISSION_FILE
}

enum DriveUploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum LiveQuizMode {
  HOST_PACED
  SELF_PACED
}

enum LiveQuizStatus {
  LOBBY
  QUESTION_OPEN
  QUESTION_CLOSED
  FINISHED
}

enum OmrSheetTemplate {
  MC_20
  MC_40
  MC_50
  THPT_2025
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  phone               String?   @unique
  name                String
  passwordHash        String
  role                Role      @default(STUDENT)
  avatarUrl           String?
  dateOfBirth         DateTime? @db.Date
  gender              String?
  bio                 String?
  isLocked            Boolean   @default(false)
  /// set when the password was generated by the system (new account / reset): user must choose a new one
  mustChangePassword  Boolean   @default(false)
  /// sessions issued before this moment are rejected (password reset / change signs out other devices)
  passwordChangedAt   DateTime?
  /// moved to the trash by an admin; purged permanently after TRASH_RETENTION_DAYS
  deletedAt           DateTime?
  /// Admin 2FA (TOTP)
  totpEnabled         Boolean   @default(false)
  totpSecretEncrypted String?
  totpBackupCodes     Json?
  totpVerifiedAt      DateTime?
  totpLastStep        Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  classesTaught              Class[]                  @relation("TeacherClasses")
  enrollments                Enrollment[]
  posts                      Post[]
  comments                   Comment[]
  worksheets                 Worksheet[]              @relation("WorksheetOwner")
  lessonsOwned               Lesson[]                 @relation("LessonOwner")
  submissions                Submission[]             @relation("StudentSubmissions")
  unlockedSubmissions        Submission[]             @relation("UnlockedByTeacher")
  notifications              Notification[]
  parentLinksAsParent        ParentLink[]             @relation("ParentUser")
  parentLinksAsChild         ParentLink[]             @relation("StudentUser")
  parentInviteCodes          ParentInviteCode[]
  driveConnectionsOwned      DriveConnection[]        @relation("DriveConnectionOwner")
  driveConnectionsLinked     DriveConnection[]        @relation("DriveConnectionActor")
  driveFiles                 DriveFile[]              @relation("DriveFileOwner")
  driveUploads               DriveUpload[]            @relation("DriveUploadOwner")
  auditLogs                  AuditLog[]               @relation("AuditLogActor")
  errorLogs                  ErrorLog[]               @relation("ErrorLogUser")
  oneTimeExports             OneTimeExport[]          @relation("OneTimeExportCreator")
  assignmentOverrides        AssignmentOverride[]     @relation("AssignmentOverrideStudent")
  assignmentTargets          AssignmentTarget[]       @relation("AssignmentTargetStudent")
  assignmentReminders        AssignmentReminderSent[] @relation("AssignmentReminderStudent")
  teacherCommentPresets      TeacherCommentPreset[]   @relation("TeacherCommentPresets")
  workbooksOwned             Workbook[]               @relation("WorkbookOwner")
  classTeacherRoles          ClassTeacher[]           @relation("ClassTeacherAssignments")
  lessonItemProgress         LessonItemProgress[]     @relation("StudentLessonProgress")
  pollVotes                  PostPollVote[]           @relation("UserPollVotes")
  postReactions              PostReaction[]           @relation("UserPostReactions")
  offlineGradeColumnsCreated OfflineGradeColumn[]     @relation("OfflineGradeColumnsCreated")
  offlineGradeEntries        OfflineGradeEntry[]      @relation("StudentOfflineGrades")
  questionBankItems          QuestionBankItem[]       @relation("QuestionBankOwner")
  examSessions               ExamSession[]            @relation("ExamSessionOwner")
  attendanceRecords          AttendanceRecord[]       @relation("StudentAttendance")
  attendanceMarked           AttendanceRecord[]       @relation("AttendanceMarkedBy")
  flashcardDecks             FlashcardDeck[]          @relation("FlashcardDeckOwner")
  flashcardReviews           FlashcardReview[]        @relation("StudentFlashcardReviews")
  studentStreak              StudentStreak?
  studentBadges              StudentBadge[]
  parentThreads              ParentThread[]           @relation("ParentThreads")
  studentMessageThreads      ParentThread[]           @relation("StudentMessageThreads")
  parentMessagesSent         ParentMessage[]          @relation("ParentMessagesSent")
  weeklyReportsReceived      WeeklyReportSent[]       @relation("WeeklyReportParent")
  weeklyReportsChild         WeeklyReportSent[]       @relation("WeeklyReportStudent")
  pushSubscriptions          PushSubscription[]
  notificationPreference     NotificationPreference?
  libraryFolders             LibraryFolder[]
  worksheetVersionsCreated   WorksheetVersion[]
  worksheetLikes             WorksheetLike[]
  followingTeachers          TeacherFollow[]          @relation("FollowFollower")
  teacherFollowers           TeacherFollow[]          @relation("FollowTeacher")
  contentReportsFiled        ContentReport[]          @relation("ContentReportReporter")
  contentReportsReviewed     ContentReport[]          @relation("ContentReportReviewer")
  aiUsageLogs                AiUsageLog[]
  passwordResetTokens        PasswordResetToken[]
  loginSessionLogs           LoginSessionLog[]
  liveQuizzesHosted          LiveQuizSession[]        @relation("LiveQuizHost")
  liveQuizParticipations     LiveQuizParticipant[]    @relation("LiveQuizParticipantUser")
  behaviorPointsReceived     StudentBehaviorPoint[]   @relation("BehaviorPointStudent")
  behaviorPointsAwarded      StudentBehaviorPoint[]   @relation("BehaviorPointAwardedBy")
  omrSheetsOwned             OmrExamSheet[]           @relation("OmrSheetOwner")
  omrScansAsStudent          OmrScanResult[]          @relation("OmrScanStudent")
  omrScansConfirmed          OmrScanResult[]          @relation("OmrScanConfirmedBy")
  aiGradingSuggestions       AiGradingSuggestion[]    @relation("AiSuggestionCreatedBy")
  similarityReviews          SimilarityReport[]       @relation("SimilarityReviewedBy")

  @@index([deletedAt])
}

model ParentLink {
  id         String    @id @default(cuid())
  parentId   String
  studentId  String
  relation   String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  parent  User @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model ParentInviteCode {
  id        String    @id @default(cuid())
  studentId String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Class {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  joinCode           String    @unique
  teacherId          String
  archived           Boolean   @default(false)
  /// Trash: set when the teacher deletes the class; purged (with assignments, submissions, posts) after 30 days
  deletedAt          DateTime?
  requireApproval    Boolean   @default(false)
  enableGamification Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacher             User                   @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  posts               Post[]
  lessons             Lesson[]
  classLessons        ClassLesson[]
  assignments         Assignment[]
  classTeachers       ClassTeacher[]
  driveFiles          DriveFile[]
  driveUploads        DriveUpload[]
  offlineGradeColumns OfflineGradeColumn[]
  scheduleRules       ClassScheduleRule[]
  sessions            ClassSession[]
  flashcardDecks      FlashcardDeck[]
  parentThreads       ParentThread[]
  liveQuizSessions    LiveQuizSession[]
  behaviorPresets     ClassBehaviorPreset[]
  behaviorPoints      StudentBehaviorPoint[]
  omrSheets           OmrExamSheet[]

  @@index([teacherId])
}

model Enrollment {
  id        String           @id @default(cuid())
  classId   String
  studentId String
  status    EnrollmentStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model Post {
  id             String   @id @default(cuid())
  classId        String
  authorId       String
  content        String
  pinned         Boolean  @default(false)
  commentsLocked Boolean  @default(false)
  attachments    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  poll      PostPoll?
  reactions PostReaction[]

  @@index([classId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Lesson {
  id            String    @id @default(cuid())
  /// Deprecated "home" class (the class it was first created in). Class membership now lives in
  /// ClassLesson; kept nullable so a rolled-back app can still read lessons created before the library.
  classId       String?
  /// Teacher who owns this lesson in their library (null if that account was deleted).
  ownerId       String?
  title         String
  description   String?
  /// Trash (Phase 14): set when moved to the trash; purged after 30 days. Source: "USER" | "DRIVE"
  deletedAt     DateTime?
  deletedSource String?
  order         Int       @default(0)
  folderId      String?
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  class        Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  owner        User?          @relation("LessonOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  folder       LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  items        LessonItem[]
  classLinks   ClassLesson[]
  driveUploads DriveUpload[]

  @@index([classId, order])
  @@index([ownerId, updatedAt])
  @@index([folderId])
}

/// A library lesson shown in a class (one lesson can be given to many classes, like a worksheet).
model ClassLesson {
  id        String   @id @default(cuid())
  classId   String
  lessonId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([classId, lessonId])
  @@index([classId, order])
  @@index([lessonId])
}

model LessonItem {
  id            String         @id @default(cuid())
  lessonId      String
  title         String
  type          LessonItemType
  fileKey       String?
  driveFileId   String?
  deletedAt     DateTime?
  deletedSource String?
  url           String?
  order         Int
  createdAt     DateTime       @default(now())

  lesson   Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress LessonItemProgress[]

  @@index([lessonId, order])
}

model Worksheet {
  id                    String           @id @default(cuid())
  ownerId               String
  title                 String
  subject               WorksheetSubject @default(GENERAL)
  instructions          String?
  passages              Json?
  pdfFileKey            String?
  pageCount             Int              @default(0)
  isShared              Boolean          @default(false) // shared with other teachers in the LMS
  folderId              String?
  tags                  String[]         @default([])
  isPublic              Boolean          @default(false)
  publicLevel           String?
  publicHiddenByAdmin   Boolean          @default(false)
  likeCount             Int              @default(0)
  lastDriveBackupAt     DateTime?
  lastDriveBackupFileId String?
  /// Trash (Phase 14): set when moved to the trash; purged after 30 days. Source: "USER" | "DRIVE"
  deletedAt             DateTime?
  deletedSource         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  owner          User               @relation("WorksheetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder         LibraryFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  pages          WorksheetPage[]
  fields         Field[]
  audios         WorksheetAudio[]
  assignments    Assignment[]
  workbookItems  WorkbookItem[]
  driveFiles     DriveFile[]
  examSessions   ExamSession[]
  versions       WorksheetVersion[]
  likes          WorksheetLike[]
  contentReports ContentReport[]
  liveQuizzes    LiveQuizSession[]

  @@index([ownerId])
  @@index([subject])
  @@index([folderId])
  @@index([isPublic, publicHiddenByAdmin, subject])
}

model WorksheetPage {
  id          String  @id @default(cuid())
  worksheetId String
  pageIndex   Int
  widthPt     Float
  heightPt    Float
  imageKey    String?

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)

  @@unique([worksheetId, pageIndex])
}

model Field {
  id          String         @id @default(cuid())
  worksheetId String
  placement   FieldPlacement
  type        FieldType
  label       String
  prompt      String?
  explanation String?
  skillTag    SkillTag?
  topicTag    String?
  passageId   String?
  imageKey    String?
  order       Int
  points      Float          @default(1)

  // Normalized coordinates 0..1 relative to page dimensions (OVERLAY only)
  pageIndex Int?
  x         Float?
  y         Float?
  w         Float?
  h         Float?
  style     Json?

  options     Json?
  answerKey   Json
  gradingOpts Json?
  rubric      Json?

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  answers   Answer[]

  // Optional link to a worksheet audio track (listening / dictation)
  audioId String?
  audio   WorksheetAudio? @relation(fields: [audioId], references: [id], onDelete: SetNull)

  // Phase 22: Optional link back to QuestionBankItem
  bankItemId String?
  bankItem   QuestionBankItem? @relation(fields: [bankItemId], references: [id], onDelete: SetNull)

  aiGradingSuggestions AiGradingSuggestion[]

  @@index([worksheetId, order])
}

model Assignment {
  id             String         @id @default(cuid())
  classId        String
  worksheetId    String
  title          String
  openAt         DateTime?
  dueAt          DateTime?
  timeLimitMin   Int?
  maxAttempts    Int?           @default(1) // null = unlimited
  shuffle        Boolean        @default(false)
  shuffleOptions Boolean        @default(false)
  showResult     ShowResultMode @default(AFTER_SUBMIT)
  showAnswerKey  Boolean        @default(false)
  allowLate      Boolean        @default(false)

  // Leaderboard
  showLeaderboard      LeaderboardMode @default(AFTER_DUE)
  leaderboardAnon      Boolean         @default(false)
  leaderboardScoreRule String          @default("BEST") // "BEST" | "LAST"

  // Proctoring
  proctorMode            ProctorMode     @default(OFF)
  violationAction        ViolationAction @default(WARN)
  maxViolations          Int             @default(3)
  requireFullscreen      Boolean         @default(false)
  blockCopyPaste         Boolean         @default(false)
  sebConfigKeyHash       String?
  shareProctorWithParent Boolean         @default(false)

  // Camera (AI) & Mic proctoring
  requireCamera       Boolean           @default(false)
  cameraEnforce       Boolean           @default(false) // false = AI events are "suspected" only
  cameraSnapshots     Boolean           @default(true)
  cameraSensitivity   CameraSensitivity @default(MEDIUM)
  cameraCountLookAway Boolean           @default(false)
  requireMicMonitor   Boolean           @default(false)

  // Listening audio rules (per assignment, so one worksheet can be practice or test)
  audioMaxPlays   Int? // null = unlimited plays per track
  audioBlockPause Boolean @default(false)
  audioBlockSeek  Boolean @default(false)

  // Focus mode: show 1 question at a time on screen (ideal for memorization / fill-in-the-blank)
  oneQuestionPerPage Boolean @default(false)

  // Phase 16: reminders & custom scoring
  remindBeforeDue Boolean    @default(true)
  scoreScale      ScoreScale @default(SCALE_10)
  weight          Float      @default(1)

  // Phase 20: Workbook & sequential unlock
  workbookId              String?
  workbookOrder           Int?
  unlockAfterAssignmentId String?

  // Phase 21: Quick textbook assignment
  isQuickTextbook Boolean @default(false)
  promptText      String?
  attachmentKeys  Json?

  // Phase 22: Multi-class ExamSession
  examSessionId String?

  // Phase 25: Open public guest practice link (strictly proctor OFF)
  publicShareToken    String? @unique
  allowPublicPractice Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class                 Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  worksheet             Worksheet                @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  workbook              Workbook?                @relation(fields: [workbookId], references: [id], onDelete: SetNull)
  unlockAfterAssignment Assignment?              @relation("AssignmentUnlockChain", fields: [unlockAfterAssignmentId], references: [id], onDelete: SetNull)
  unlockedAssignments   Assignment[]             @relation("AssignmentUnlockChain")
  examSession           ExamSession?             @relation(fields: [examSessionId], references: [id], onDelete: SetNull)
  examVariants          ExamVariant[]
  submissions           Submission[]
  overrides             AssignmentOverride[]
  targets               AssignmentTarget[]
  reminders             AssignmentReminderSent[]
  publicAttempts        PublicAttempt[]

  similarityReports SimilarityReport[]

  @@index([classId])
  @@index([worksheetId])
  @@index([workbookId])
  @@index([examSessionId])
}

model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  attemptNo      Int
  status         SubmissionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  isLate         Boolean          @default(false)
  autoScore      Float?
  manualScore    Float?
  totalScore     Float?
  maxScore       Float
  questionOrder  Json?
  optionOrder    Json?
  teacherComment String?

  // Proctoring tracking
  violationCount  Int       @default(0)
  flagged         Boolean   @default(false)
  lockedAt        DateTime?
  attemptVersion  Int       @default(0)
  restartCount    Int       @default(0)
  rulesAcceptedAt DateTime?
  cameraConsentAt DateTime?
  unlockedById    String?
  attemptToken    String?
  lastHeartbeatAt DateTime?
  examVariantId   String?

  assignment    Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       User                 @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  unlockedBy    User?                @relation("UnlockedByTeacher", fields: [unlockedById], references: [id], onDelete: SetNull)
  examVariant   ExamVariant?         @relation(fields: [examVariantId], references: [id], onDelete: SetNull)
  answers       Answer[]
  proctorEvents ProctorEvent[]
  audioPlays    AudioPlay[]
  driveFiles    DriveFile[]
  revisions     SubmissionRevision[]

  aiGradingSuggestions AiGradingSuggestion[]

  @@unique([assignmentId, studentId, attemptNo])
  @@index([studentId])
  @@index([assignmentId, status])
}

model ProctorEvent {
  id           String           @id @default(cuid())
  submissionId String
  type         ProctorEventType
  at           DateTime         @default(now())
  durationMs   Int?
  meta         Json?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, at])
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  fieldId      String
  value        Json
  isCorrect    Boolean?
  score        Float?
  isOverridden Boolean  @default(false)
  gradeDetail  Json?
  rubricScores Json?
  annotations  Json?
  teacherNote  String?
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model WorksheetAudio {
  id          String   @id @default(cuid())
  worksheetId String
  title       String
  fileKey     String
  mimeType    String
  sizeBytes   Int      @default(0)
  durationSec Int?
  order       Int
  createdAt   DateTime @default(now())

  worksheet Worksheet   @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  fields    Field[]
  plays     AudioPlay[]

  @@index([worksheetId, order])
}

/// One row per play granted by the server (counted server-side, never trusted from client).
model AudioPlay {
  id           String   @id @default(cuid())
  submissionId String
  audioId      String
  startedAt    DateTime @default(now())

  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  audio      WorksheetAudio @relation(fields: [audioId], references: [id], onDelete: Cascade)

  @@index([submissionId, audioId])
}

model DriveConnection {
  id                      String                @id @default(cuid())
  scopeKey                String                @unique // "shared" or "user:<ownerId>"
  ownerId                 String?
  connectedById           String
  email                   String
  encryptedRefreshToken   String
  scope                   String
  status                  DriveConnectionStatus @default(ACTIVE)
  rootFolderId            String?
  allowPublicLessonVideos Boolean               @default(false)
  autoBackupEnabled       Boolean               @default(false)
  lastAutoBackupAt        DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  owner       User?         @relation("DriveConnectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  connectedBy User          @relation("DriveConnectionActor", fields: [connectedById], references: [id], onDelete: Cascade)
  files       DriveFile[]
  uploads     DriveUpload[]
  trashItems  DriveTrash[]

  @@index([ownerId, status])
}

model DriveFile {
  id            String        @id @default(cuid())
  storageKey    String        @unique
  driveFileId   String        @unique
  connectionId  String
  ownerId       String?
  name          String
  mimeType      String
  size          Int           @default(0)
  md5           String?
  kind          DriveFileKind
  worksheetId   String?
  classId       String?
  submissionId  String?
  shared        Boolean       @default(false)
  trashedAt     DateTime?
  /// In Google Drive's trash because its worksheet / lesson is in Pivora's trash (restorable)
  softTrashedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  connection DriveConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  owner      User?           @relation("DriveFileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  worksheet  Worksheet?      @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  class      Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  submission Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([connectionId, kind])
  @@index([ownerId, kind])
  @@index([worksheetId])
  @@index([classId])
  @@index([submissionId])
}

model DriveUpload {
  id                  String            @id @default(cuid())
  connectionId        String
  ownerId             String
  classId             String
  lessonId            String?
  name                String
  mimeType            String
  size                Int
  kind                String            @default("video") // "video" | "document"
  status              DriveUploadStatus @default(PENDING)
  bytesUploaded       Int               @default(0)
  encryptedSessionUri String?
  driveFileId         String?           @unique
  storageKey          String?
  shared              Boolean           @default(false)
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  connection DriveConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  owner      User            @relation("DriveUploadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  class      Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson     Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([classId, status])
  @@index([lessonId])
}

model DriveTrash {
  id           String   @id @default(cuid())
  driveFileId  String
  connectionId String?
  storageKey   String?
  reason       String?
  createdAt    DateTime @default(now())

  connection DriveConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  summary    String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model ErrorLog {
  id         String   @id @default(cuid())
  source     String // "SERVER" | "CLIENT"
  level      String   @default("ERROR") // "ERROR" | "WARN" | "FATAL"
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int?
  userId     String?
  userAgent  String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation("ErrorLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source, createdAt])
}

/// Encrypted one-time download (e.g. temporary passwords generated by admin bulk Excel import).
model OneTimeExport {
  id               String    @id @default(cuid())
  createdById      String
  encryptedPayload String
  expiresAt        DateTime
  downloadedAt     DateTime?
  createdAt        DateTime  @default(now())

  createdBy User @relation("OneTimeExportCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([expiresAt])
}

/// Phase 16: per-student deadline / extra attempts / time limit overrides for an assignment.
model AssignmentOverride {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  extraAttempts Int       @default(0)
  dueAt         DateTime?
  timeLimitMin  Int?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentOverrideStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Phase 16: optional targeted student subset for an assignment (0 rows = whole class).
model AssignmentTarget {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentTargetStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Phase 16: tracks which students already received the 24h due-soon reminder for an assignment.
model AssignmentReminderSent {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  sentAt       DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AssignmentReminderStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
}

/// Phase 16: reusable teacher comment snippets when grading.
model TeacherCommentPreset {
  id        String   @id @default(cuid())
  teacherId String
  category  String?
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("TeacherCommentPresets", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, order])
}

/// Phase 20: Teacher workbook grouping ordered worksheets for multi-session assignment & matrix tracking.
model Workbook {
  id          String    @id @default(cuid())
  ownerId     String
  title       String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User           @relation("WorkbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items       WorkbookItem[]
  assignments Assignment[]

  @@index([ownerId])
}

model WorkbookItem {
  id          String @id @default(cuid())
  workbookId  String
  worksheetId String
  order       Int    @default(0)

  workbook  Workbook  @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)

  @@unique([workbookId, worksheetId])
  @@index([workbookId, order])
}

/// Phase 20: Snapshot of student submission saved when returned by teacher for revision.
model SubmissionRevision {
  id              String    @id @default(cuid())
  submissionId    String
  revisionNo      Int
  submittedAt     DateTime
  returnedAt      DateTime?
  teacherComment  String?
  answersSnapshot Json
  totalScore      Float?
  maxScore        Float
  createdAt       DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, revisionNo])
}

/// Phase 20: Co-teachers & teaching assistants invited to a class.
model ClassTeacher {
  id        String    @id @default(cuid())
  classId   String
  userId    String
  role      ClassRole @default(CO_TEACHER)
  createdAt DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation("ClassTeacherAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

/// Phase 20: Tracks student completion / view counts for individual lesson materials.
model LessonItemProgress {
  id           String   @id @default(cuid())
  lessonItemId String
  studentId    String
  completedAt  DateTime @default(now())
  viewCount    Int      @default(1)

  lessonItem LessonItem @relation(fields: [lessonItemId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonItemId, studentId])
  @@index([studentId])
}

/// Phase 20: Classroom feed polls & reactions.
model PostPoll {
  id            String    @id @default(cuid())
  postId        String    @unique
  question      String
  allowMultiple Boolean   @default(false)
  closesAt      DateTime?

  post    Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PostPollOption[]
}

model PostPollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  order  Int    @default(0)

  poll  PostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PostPollVote[]

  @@index([pollId, order])
}

model PostPollVote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User           @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserPostReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

/// Phase 21: In-class / paper grade columns & student entries.
model OfflineGradeColumn {
  id          String   @id @default(cuid())
  classId     String
  title       String
  date        DateTime @default(now())
  maxScore    Float    @default(10)
  weight      Float    @default(1)
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User                @relation("OfflineGradeColumnsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  entries   OfflineGradeEntry[]

  @@index([classId, date])
}

model OfflineGradeEntry {
  id        String   @id @default(cuid())
  columnId  String
  studentId String
  score     Float?
  note      String?
  updatedAt DateTime @updatedAt

  column  OfflineGradeColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  student User               @relation("StudentOfflineGrades", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([columnId, studentId])
  @@index([studentId])
}

/// Phase 22: Reusable question bank with multi-dimensional tagging & sharing.
model QuestionBankItem {
  id          String           @id @default(cuid())
  ownerId     String
  subject     WorksheetSubject @default(GENERAL)
  type        FieldType
  prompt      String
  options     Json?
  answerKey   Json
  explanation String?
  rubric      Json?
  skillTag    SkillTag?
  topicTag    String?
  level       String?
  difficulty  Int              @default(3)
  tags        String[]         @default([])
  audioKey    String?
  imageKey    String?
  isShared    Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner  User    @relation("QuestionBankOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  fields Field[]

  @@index([ownerId, subject])
  @@index([isShared, subject])
}

/// Phase 22: Pre-generated exam paper codes (101, 102, ...) for an assignment.
model ExamVariant {
  id            String   @id @default(cuid())
  assignmentId  String
  code          String
  questionOrder Json
  optionOrder   Json
  createdAt     DateTime @default(now())

  assignment  Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([assignmentId, code])
}

/// Phase 22: Multi-class synchronized exam session sharing one worksheet & proctoring config.
model ExamSession {
  id            String    @id @default(cuid())
  ownerId       String
  title         String
  worksheetId   String
  openAt        DateTime?
  dueAt         DateTime?
  timeLimitMin  Int?
  proctorConfig Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner       User         @relation("ExamSessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  worksheet   Worksheet    @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([ownerId])
}

/// Phase 23: Weekly recurring class timetable rule.
model ClassScheduleRule {
  id            String    @id @default(cuid())
  classId       String
  dayOfWeek     Int
  startTime     String
  endTime       String
  title         String?
  meetingUrl    String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessions ClassSession[]

  @@index([classId, active])
}

/// Phase 23: Individual scheduled or makeup class session.
model ClassSession {
  id            String        @id @default(cuid())
  classId       String
  ruleId        String?
  title         String
  startsAt      DateTime
  endsAt        DateTime
  status        SessionStatus @default(SCHEDULED)
  isMakeup      Boolean       @default(false)
  meetingUrl    String?
  notes         String?
  lessonIds     Json?
  assignmentIds Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  class             Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  rule              ClassScheduleRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  behaviorPoints    StudentBehaviorPoint[]

  @@unique([ruleId, startsAt])
  @@index([classId, startsAt])
}

/// Phase 23: Per-student attendance status for a class session.
model AttendanceRecord {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String?
  markedAt   DateTime         @default(now())

  session  ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  User         @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User?        @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

/// Phase 24: Flashcard deck (owned by teacher for class/personal or by student).
model FlashcardDeck {
  id          String   @id @default(cuid())
  ownerId     String
  classId     String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User?       @relation("FlashcardDeckOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  class Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  cards Flashcard[]

  @@index([ownerId])
  @@index([classId])
}

/// Phase 24: Individual flashcard item inside a deck.
model Flashcard {
  id       String  @id @default(cuid())
  deckId   String
  front    String
  back     String
  phonetic String?
  example  String?
  audioKey String?
  order    Int     @default(0)

  deck    FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([deckId, order])
}

/// Phase 24: SM-2 spaced repetition state per (flashcard, student).
model FlashcardReview {
  id             String    @id @default(cuid())
  flashcardId    String
  studentId      String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentFlashcardReviews", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, studentId])
  @@index([studentId, nextReviewAt])
}

/// Phase 24: Student daily study streak (Asia/Ho_Chi_Minh).
model StudentStreak {
  userId           String   @id
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate String?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Phase 24: Achievement badges earned by students.
model StudentBadge {
  id       String   @id @default(cuid())
  userId   String
  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

/// Phase 24: 1-on-1 message thread between a verified parent and class teachers.
model ParentThread {
  id            String   @id @default(cuid())
  classId       String
  parentId      String
  studentId     String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  class    Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  parent   User            @relation("ParentThreads", fields: [parentId], references: [id], onDelete: Cascade)
  student  User            @relation("StudentMessageThreads", fields: [studentId], references: [id], onDelete: Cascade)
  messages ParentMessage[]

  @@unique([classId, parentId, studentId])
}

/// Phase 24: Individual chat message inside a ParentThread.
model ParentMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread ParentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation("ParentMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Phase 24: Tracks weekly parent report dispatches to avoid duplicate emails.
model WeeklyReportSent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  weekKey   String
  sentAt    DateTime @default(now())

  parent  User @relation("WeeklyReportParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("WeeklyReportStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId, weekKey])
}

/// Phase 24: Encrypted browser Web Push subscriptions per user.
model PushSubscription {
  id              String   @id @default(cuid())
  userId          String
  endpoint        String   @unique
  p256dhEncrypted String
  authEncrypted   String
  userAgent       String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Phase 24: Per-user notification channel preferences.
model NotificationPreference {
  userId             String   @id
  emailEnabled       Boolean  @default(true)
  emailAssignmentNew Boolean  @default(true)
  emailDueReminder   Boolean  @default(true)
  emailWeeklyReport  Boolean  @default(true)
  pushEnabled        Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Phase 25: Multi-level folder tree for organizing worksheets and lessons.
model LibraryFolder {
  id        String   @id @default(cuid())
  ownerId   String
  parentId  String?
  kind      String // "WORKSHEET" | "LESSON"
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent     LibraryFolder?  @relation("LibraryFolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   LibraryFolder[] @relation("LibraryFolderHierarchy")
  worksheets Worksheet[]
  lessons    Lesson[]

  @@index([ownerId, kind])
}

/// Phase 25: Point-in-time worksheet version snapshots (max 30 retained per worksheet).
model WorksheetVersion {
  id          String   @id @default(cuid())
  worksheetId String
  versionNo   Int
  note        String?
  createdById String?
  snapshot    Json
  createdAt   DateTime @default(now())

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([worksheetId, versionNo])
}

/// Phase 25: Public worksheet community likes.
model WorksheetLike {
  worksheetId String
  userId      String
  createdAt   DateTime @default(now())

  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([worksheetId, userId])
}

/// Phase 25: Teacher follow subscriptions from the Discover portal.
model TeacherFollow {
  followerId String
  teacherId  String
  createdAt  DateTime @default(now())

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  teacher  User @relation("FollowTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([followerId, teacherId])
}

/// Phase 25: Community moderation reports on public worksheets.
model ContentReport {
  id           String    @id @default(cuid())
  worksheetId  String
  reporterId   String
  reason       String
  status       String    @default("OPEN") // "OPEN" | "HIDDEN" | "DISMISSED"
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  worksheet  Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  reporter   User      @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ContentReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Phase 25: Daily AI generation quota ledger per teacher.
model AiUsageLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  dayKey     String
  tokensUsed Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
}

/// Phase 25: Anonymous guest attempts via public share practice links (isolated from Submission & leaderboard).
model PublicAttempt {
  id           String   @id @default(cuid())
  assignmentId String
  guestName    String
  answers      Json
  autoScore    Float
  maxScore     Float
  submittedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, submittedAt])
}

/// Phase 26: One-time SHA-256 hashed password reset tokens (30 min TTL).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Phase 26: Recent successful login session audit rows per user (IP masked for privacy).
model LoginSessionLog {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  ipMasked  String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Phase 27: Live classroom quiz (Kahoot-style) or one-question exit ticket. Questions frozen in `questionsSnapshot`.
model LiveQuizSession {
  id                String         @id @default(cuid())
  hostId            String
  classId           String?
  worksheetId       String?
  title             String
  pinCode           String         @unique
  mode              LiveQuizMode   @default(HOST_PACED)
  status            LiveQuizStatus @default(LOBBY)
  currentIndex      Int            @default(0)
  questionStartedAt DateTime?
  questionLimitSec  Int            @default(30)
  isExitTicket      Boolean        @default(false)
  questionsSnapshot Json
  createdAt         DateTime       @default(now())
  endedAt           DateTime?

  host         User                  @relation("LiveQuizHost", fields: [hostId], references: [id], onDelete: Cascade)
  class        Class?                @relation(fields: [classId], references: [id], onDelete: SetNull)
  worksheet    Worksheet?            @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  participants LiveQuizParticipant[]
  answers      LiveQuizAnswer[]

  @@index([hostId, createdAt])
  @@index([classId])
}

/// Phase 27: A player in a live quiz (logged-in student or guest identified by a hashed join token).
model LiveQuizParticipant {
  id            String   @id @default(cuid())
  sessionId     String
  userId        String?
  displayName   String
  joinTokenHash String
  totalScore    Int      @default(0)
  correctCount  Int      @default(0)
  streak        Int      @default(0)
  joinedAt      DateTime @default(now())

  session LiveQuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?            @relation("LiveQuizParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  answers LiveQuizAnswer[]

  @@unique([sessionId, joinTokenHash])
  @@index([sessionId, totalScore])
}

/// Phase 27: One answer per participant per question (server-timed).
model LiveQuizAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  questionIndex Int
  answer        Json
  isCorrect     Boolean
  responseMs    Int
  pointsAwarded Int      @default(0)
  answeredAt    DateTime @default(now())

  session     LiveQuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant LiveQuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionIndex])
  @@index([sessionId, questionIndex])
}

/// Phase 27: Reusable behavior point buttons per class (e.g. "Good answer +2").
model ClassBehaviorPreset {
  id        String   @id @default(cuid())
  classId   String
  label     String
  delta     Int
  icon      String?
  createdAt DateTime @default(now())

  class  Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  points StudentBehaviorPoint[]

  @@index([classId])
}

/// Phase 27: Behavior (star) points awarded or deducted for a student in a class.
model StudentBehaviorPoint {
  id          String   @id @default(cuid())
  classId     String
  studentId   String
  sessionId   String?
  presetId    String?
  delta       Int
  reason      String
  awardedById String
  createdAt   DateTime @default(now())

  class     Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User                 @relation("BehaviorPointStudent", fields: [studentId], references: [id], onDelete: Cascade)
  session   ClassSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  preset    ClassBehaviorPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  awardedBy User                 @relation("BehaviorPointAwardedBy", fields: [awardedById], references: [id], onDelete: Cascade)

  @@index([classId, studentId])
  @@index([sessionId])
}

/// Phase 28: Paper bubble-sheet exam graded by phone camera (OMR).
model OmrExamSheet {
  id                 String           @id @default(cuid())
  ownerId            String
  classId            String
  assignmentId       String?
  title              String
  template           OmrSheetTemplate
  /// { [variantCode | "default"]: { mc: { "1": "A" }, tf: { "1": { a: true } }, sa: { "1": "1,5" } } }
  answerKeyByVariant Json
  /// { mcPoints, tfPoints, saPoints } (points per question; TF uses THPT 2025 progressive scoring)
  pointsConfig       Json
  offlineColumnId    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  owner User            @relation("OmrSheetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  class Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  scans OmrScanResult[]

  @@index([classId, createdAt])
}

/// Phase 28: One scanned answer sheet (image stored at omr/{sheetId}/{uuid}.jpg). Score is always computed on the server.
model OmrScanResult {
  id              String    @id @default(cuid())
  sheetId         String
  studentId       String?
  detectedSbd     String?
  variantCode     String?
  scanImageKey    String
  rawBubbles      Json
  resolvedAnswers Json
  score           Float
  maxScore        Float
  confidence      Float
  needsReview     Boolean   @default(false)
  confirmedById   String?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())

  sheet       OmrExamSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  student     User?        @relation("OmrScanStudent", fields: [studentId], references: [id], onDelete: SetNull)
  confirmedBy User?        @relation("OmrScanConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([sheetId, createdAt])
  @@index([studentId])
}

/// Phase 29: AI-suggested manual grade for one answer. Never overwrites Answer.score until a teacher applies it.
model AiGradingSuggestion {
  id                    String    @id @default(cuid())
  submissionId          String
  fieldId               String
  suggestedScore        Float
  suggestedRubricScores Json?
  suggestedComment      String
  model                 String
  appliedAt             DateTime?
  createdById           String
  createdAt             DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("AiSuggestionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
}

/// Phase 29: Pairwise similarity (Winnowing) between two students' answers to the same question.
model SimilarityReport {
  id            String    @id @default(cuid())
  assignmentId  String
  fieldId       String
  submissionAId String
  submissionBId String
  similarity    Float
  matchedSpans  Json
  /// OPEN | DISMISSED | CONFIRMED
  status        String    @default("OPEN")
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("SimilarityReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, fieldId, submissionAId, submissionBId])
  @@index([assignmentId, similarity])
}

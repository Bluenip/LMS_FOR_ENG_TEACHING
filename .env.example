# App branding
NEXT_PUBLIC_APP_NAME="Pivora"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Hiện các tài khoản mẫu (mật khẩu password123) trên trang đăng nhập khi chạy production. Để false khi host công khai.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Database (PostgreSQL)
DATABASE_URL="postgresql://engclass:engclass_secret@localhost:5432/engclass?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
AUTH_TRUST_HOST="true"

# Optional Google OAuth
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# File Storage ("local" | "s3" | "drive")
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="20"

# S3 / R2 / MinIO (only needed when STORAGE_DRIVER="s3")
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="engclass-files"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Camera AI Proctoring
# Số ngày lưu ảnh bằng chứng chụp từ camera trước khi script `pnpm proctor:purge-snapshots` tự động xoá
PROCTOR_SNAPSHOT_RETENTION_DAYS="30"
# Đặt = 1 nếu chạy `pnpm i` trong môi trường không có mạng (bỏ qua tải model MediaPipe)
SKIP_MEDIAPIPE_MODEL_DOWNLOAD="0"

# Google Drive Integration (Phase 12)
# URL gốc của ứng dụng, dùng để tạo OAuth redirect URI và kiểm tra header Origin
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Mặc định tự lấy ${APP_URL}/api/drive/callback nếu để trống
GOOGLE_REDIRECT_URI=""
# Khoá mã hoá AES-256-GCM (tối thiểu 32 ký tự): openssl rand -base64 48 ; đổi key = phải kết nối lại Drive
DRIVE_ENCRYPTION_KEY=""
# Tuỳ chọn: dùng cho Google Picker (chọn file PDF / DOCX / backup trực tiếp từ Drive)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=""
# Chu kỳ chạy job dọn thùng rác Drive (phút). Đặt 0 để tắt job nền.
DRIVE_PRUNE_INTERVAL_MINUTES="60"
# Giờ chạy tự động sao lưu hằng ngày (0-23, giờ máy chủ)
DRIVE_AUTO_BACKUP_HOUR="2"
# Số bản backup tối đa giữ lại cho mỗi worksheet / thư viện
DRIVE_BACKUP_RETENTION="14"

# Phase 13 — Quản trị & vận hành
# Khoá mã hoá AES-256-GCM cho secret TOTP 2FA và file mật khẩu tạm một lần (tối thiểu 32 ký tự: openssl rand -base64 48).
# Nếu bỏ trống, hệ thống dùng khóa dẫn xuất từ AUTH_SECRET. Đặt giá trị ngắn hơn 32 ký tự sẽ bị báo lỗi (không tự fallback).
TOTP_ENCRYPTION_KEY=""
# Tuỳ chọn: Sentry DSN để chuyển tiếp lỗi server/client ngoài bảng ErrorLog trong DB
SENTRY_DSN=""

# Phase 24 — Thông báo đa kênh (Web Push, SMTP Email, Telegram / Webhook)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@pivora.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pivora LMS <no-reply@pivora.local>"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
ALERT_WEBHOOK_URL=""

# App branding
NEXT_PUBLIC_APP_NAME="EngClass"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Hiện các tài khoản mẫu (mật khẩu password123) trên trang đăng nhập khi chạy production. Để false khi host công khai.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Database (PostgreSQL)
DATABASE_URL="postgresql://engclass:engclass_secret@localhost:5432/engclass?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
AUTH_TRUST_HOST="true"

# Optional Google OAuth
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# File Storage ("local" | "s3")
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="20"

# S3 / R2 / MinIO (only needed when STORAGE_DRIVER="s3")
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="engclass-files"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Camera AI Proctoring
# Số ngày lưu ảnh bằng chứng chụp từ camera trước khi script `pnpm proctor:purge-snapshots` tự động xoá
PROCTOR_SNAPSHOT_RETENTION_DAYS="30"
# Đặt = 1 nếu chạy `pnpm i` trong môi trường không có mạng (bỏ qua tải model MediaPipe)
SKIP_MEDIAPIPE_MODEL_DOWNLOAD="0"
